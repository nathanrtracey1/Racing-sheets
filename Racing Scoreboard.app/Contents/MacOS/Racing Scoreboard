#!/usr/bin/env bash
# Racing Scoreboard — native window launcher
# Uses pywebview (WKWebView) so no browser is opened.

# Resolve this script's real path (handles symlinks)
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
# MacOS/ → Contents/ → .app/ → repo/
REPO_DIR="$(dirname "$(dirname "$(dirname "$SCRIPT_DIR")")")"

# ── Require Python 3 ──────────────────────────────────────────────────────────
if ! command -v python3 &>/dev/null; then
    osascript -e 'display alert "Python 3 Required" message "Install Python 3 from python.org or with Homebrew (brew install python3), then reopen the app." as critical'
    exit 1
fi

# ── Install pywebview once if missing ─────────────────────────────────────────
if ! python3 -c "import webview" 2>/dev/null; then
    CHOICE=$(osascript <<'AS' 2>/dev/null
display dialog "Racing Scoreboard needs pywebview for its native window (one-time setup, ~5 MB)." & return & "Connect to the internet, then click Install." buttons {"Cancel", "Install"} default button "Install" with icon note
AS
)
    [[ "$CHOICE" != *"Install"* ]] && exit 0
    python3 -m pip install pywebview --quiet --user 2>&1 || {
        osascript -e 'display alert "Install failed" message "Open Terminal and run: pip3 install pywebview — then reopen the app." as critical'
        exit 1
    }
fi

exec python3 "$REPO_DIR/app.py"
