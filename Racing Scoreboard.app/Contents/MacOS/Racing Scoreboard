#!/usr/bin/env bash
# Racing Scoreboard — native window launcher
# Requires Python 3.10+ (python.org or Homebrew). Python 3.9 from Xcode CLT
# does not work because pyobjc-core 12 dropped 3.9 support.

# Resolve this script's real path (handles symlinks)
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
# MacOS/ → Contents/ → .app/ → repo/
REPO_DIR="$(dirname "$(dirname "$(dirname "$SCRIPT_DIR")")")"

# ── Find Python 3.10+ ─────────────────────────────────────────────────────────
# python.org installs to /Library/Frameworks/Python.framework/...
# Homebrew installs to /opt/homebrew/bin/ (Apple Silicon) or /usr/local/bin/ (Intel)
PYTHON=""
for candidate in \
    /Library/Frameworks/Python.framework/Versions/3.13/bin/python3.13 \
    /Library/Frameworks/Python.framework/Versions/3.12/bin/python3.12 \
    /Library/Frameworks/Python.framework/Versions/3.11/bin/python3.11 \
    /Library/Frameworks/Python.framework/Versions/3.10/bin/python3.10 \
    /opt/homebrew/bin/python3.13 \
    /opt/homebrew/bin/python3.12 \
    /opt/homebrew/bin/python3.11 \
    /opt/homebrew/bin/python3 \
    /usr/local/bin/python3.13 \
    /usr/local/bin/python3.12 \
    /usr/local/bin/python3.11 \
    /usr/local/bin/python3 \
    python3.13 python3.12 python3.11 python3.10; do
    if [ -x "$candidate" ] || command -v "$candidate" &>/dev/null; then
        MINOR=$("$candidate" -c "import sys; print(sys.version_info.minor)" 2>/dev/null)
        MAJOR=$("$candidate" -c "import sys; print(sys.version_info.major)" 2>/dev/null)
        if [ "$MAJOR" = "3" ] && [ "${MINOR:-0}" -ge 10 ]; then
            PYTHON="$candidate"
            break
        fi
    fi
done

if [ -z "$PYTHON" ]; then
    osascript -e 'display alert "Python 3.10+ Required" message "Install Python 3.12 (free) from python.org, then reopen this app. The built-in macOS Python 3.9 is too old for this app." as critical'
    open "https://www.python.org/downloads/"
    exit 1
fi

# ── Install pywebview once if missing ─────────────────────────────────────────
if ! "$PYTHON" -c "import webview" 2>/dev/null; then
    CHOICE=$(osascript <<'AS' 2>/dev/null
display dialog "Racing Scoreboard needs pywebview for its native window (one-time setup, ~5 MB)." & return & "Connect to the internet, then click Install." buttons {"Cancel", "Install"} default button "Install" with icon note
AS
)
    [[ "$CHOICE" != *"Install"* ]] && exit 0
    "$PYTHON" -m pip install pywebview --quiet --user 2>&1 || {
        osascript -e 'display alert "Install failed" message "Open Terminal and run the install command shown in launch.command, then reopen the app." as critical'
        exit 1
    }
fi

exec "$PYTHON" "$REPO_DIR/app.py"
