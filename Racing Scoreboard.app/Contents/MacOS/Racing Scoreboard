#!/usr/bin/env bash
# Racing Scoreboard — native window launcher
# Uses a .venv inside the repo so it works with Homebrew Python (PEP 668).

# Resolve this script's real path (handles symlinks)
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
# MacOS/ → Contents/ → .app/ → repo/
REPO_DIR="$(dirname "$(dirname "$(dirname "$SCRIPT_DIR")")")"
VENV="$REPO_DIR/.venv"

# ── Find Python 3.10+ ─────────────────────────────────────────────────────────
PYTHON=""
for candidate in \
    /Library/Frameworks/Python.framework/Versions/3.14/bin/python3.14 \
    /Library/Frameworks/Python.framework/Versions/3.13/bin/python3.13 \
    /Library/Frameworks/Python.framework/Versions/3.12/bin/python3.12 \
    /Library/Frameworks/Python.framework/Versions/3.11/bin/python3.11 \
    /Library/Frameworks/Python.framework/Versions/3.10/bin/python3.10 \
    /opt/homebrew/bin/python3.14 \
    /opt/homebrew/bin/python3.13 \
    /opt/homebrew/bin/python3.12 \
    /opt/homebrew/bin/python3.11 \
    /opt/homebrew/bin/python3 \
    /usr/local/bin/python3.14 \
    /usr/local/bin/python3.13 \
    /usr/local/bin/python3.12 \
    /usr/local/bin/python3.11 \
    /usr/local/bin/python3 \
    python3.14 python3.13 python3.12 python3.11 python3.10; do
    if [ -x "$candidate" ] || command -v "$candidate" &>/dev/null; then
        MINOR=$("$candidate" -c "import sys; print(sys.version_info.minor)" 2>/dev/null)
        MAJOR=$("$candidate" -c "import sys; print(sys.version_info.major)" 2>/dev/null)
        if [ "$MAJOR" = "3" ] && [ "${MINOR:-0}" -ge 10 ]; then
            PYTHON="$candidate"
            break
        fi
    fi
done

if [ -z "$PYTHON" ]; then
    osascript -e 'display alert "Python 3.10+ Required" message "Install Python 3.12 (free) from python.org, then reopen this app." as critical'
    open "https://www.python.org/downloads/"
    exit 1
fi

# ── Create venv if it doesn't exist ──────────────────────────────────────────
if [ ! -x "$VENV/bin/python" ]; then
    osascript -e 'display notification "Setting up Racing Scoreboard (one-time)…" with title "Racing Scoreboard"'
    "$PYTHON" -m venv "$VENV" || {
        osascript -e 'display alert "Setup failed" message "Could not create virtual environment. Try running launch.command in Terminal for details." as critical'
        exit 1
    }
fi

# ── Install pywebview into venv if missing ────────────────────────────────────
if ! "$VENV/bin/python" -c "import webview" 2>/dev/null; then
    CHOICE=$(osascript <<'AS' 2>/dev/null
display dialog "Racing Scoreboard needs pywebview (one-time setup, ~5 MB, requires internet)." buttons {"Cancel", "Install"} default button "Install" with icon note
AS
)
    [[ "$CHOICE" != *"Install"* ]] && exit 0
    "$VENV/bin/pip" install pywebview --quiet || {
        osascript -e 'display alert "Install failed" message "Check your internet connection, then reopen the app." as critical'
        exit 1
    }
fi

exec "$VENV/bin/python" "$REPO_DIR/app.py"
